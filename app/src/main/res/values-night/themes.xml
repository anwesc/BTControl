<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night Mode -->
    <style name="Theme.BTControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/white</item> <!-- 夜间模式字体为白色 -->
        <item name="android:textColorSecondary">@color/grey_400</item> <!-- 灰色次级字体 -->

        <!-- 防止界面异常全屏 -->
        <item name="android:windowFullscreen">false</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item> <!-- 深色状态栏 -->

        <!-- 设置状态栏文字颜色 -->
        <item name="android:windowLightStatusBar">false</item> <!-- 白色文字 -->

        <!-- 应用主色 -->
        <item name="colorPrimary">@color/colorPrimary</item> <!-- 更深的主色-->
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item> <!-- 更深的主色变体-->
        <item name="colorOnPrimary">@color/white</item>

        <!-- 次级色 -->
        <item name="colorSecondary">@color/colorSecondary</item> <!-- 稍微深一点的次级色 -->
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/white</item> <!-- 白色文字对比深色背景更清晰 -->

        <!-- 应用启动背景 -->
        <item name="android:windowBackground">@color/background</item> <!-- 深色背景 #121212 -->
        <item name="cardBackgroundColor">@color/surface_night</item> <!-- 卡片比页面亮一级，层级看得出来 -->

        <!-- 对话框按钮用强调蓝，避免主色在夜间过暗 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BTControl.AlertDialog</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BTControl.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.BTControl.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/grey_400</item>
    </style>
</resources>

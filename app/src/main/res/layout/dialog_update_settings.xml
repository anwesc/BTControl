<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <Switch
            android:id="@+id/autoCheckSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/版本_自动检查" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/版本_自动检查说明"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/silentInstallSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/版本_静默安装" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/版本_静默安装说明"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/版本_更新源"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/manifestUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/版本_更新源"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="3"
            android:minHeight="40dp"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/版本_更新源说明"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="11sp"
            android:textColor="?android:textColorSecondary"
            android:id="@+id/updateEnvText" />
    </LinearLayout>
</ScrollView>

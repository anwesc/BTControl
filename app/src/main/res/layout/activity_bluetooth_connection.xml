<?xml version="1.0" encoding="utf-8"?>
<!-- item_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="29dp"
        android:layout_marginBottom="16dp"
        android:gravity="center|center_horizontal"
        android:orientation="horizontal">

        <!-- Status TextView -->

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="304dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/status"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/image_accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="无障碍"
            android:src="@mipmap/accessibility" />

    </LinearLayout>

    <!-- Connected Devices Label -->
    <TextView
        android:id="@+id/connectedDevicesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="已保存设备"
        android:textSize="16sp" />

    <!-- Connected Devices ListView -->
    <ListView
        android:id="@+id/connectedDeviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp" />

    <!-- Nearby Devices Label -->

    <!-- Nearby Devices ListView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginBottom="16dp"
        android:gravity="center|center_horizontal"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginBottom="0dp"
            android:gravity="start|left"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nearbyDevicesLabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="周围设备"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:indeterminate="true" />

        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="20dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="?android:attr/listDivider"
            android:visibility="invisible" />

        <Button
            android:id="@+id/actionButton"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="停止" />

    </LinearLayout>

    <ListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="2dp" />

    <!-- Non-Frequent Devices ListView -->
    <TextView
        android:id="@+id/NFDeviceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="非常用设备"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/NFDeviceListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="2dp" />

</LinearLayout>

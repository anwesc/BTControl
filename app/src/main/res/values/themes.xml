<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BTControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">@color/black</item> <!-- 白天模式字体为黑色 -->
        <item name="android:textColorSecondary">@color/grey_700</item> <!-- 灰色次级字体 -->

        <!-- 防止界面异常全屏 -->
        <item name="android:windowFullscreen">false</item>

        <!-- 状态栏颜色 -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <!-- 设置状态栏文字颜色 -->
        <item name="android:windowLightStatusBar">true</item> <!-- 深色文字 -->

        <!-- 应用主色 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- 次级色 -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 应用启动背景 -->
        <item name="android:windowBackground">@color/white</item>
        <item name="cardBackgroundColor">@color/white</item> <!-- 白天是白色 -->
    </style>
</resources>
